RewriteEngine On

# Canonical public host: consolidate old HTTP/www URLs into one HTTPS origin for search engines.
RewriteCond %{HTTPS} !=on [OR]
RewriteCond %{HTTP_HOST} !^techselectai\.com$ [NC]
RewriteRule ^ https://techselectai.com%{REQUEST_URI} [R=301,L,NE]

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "DENY"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
</IfModule>

RewriteRule ^(?:app|db|docs|scripts)/ - [F,L]
RewriteRule ^(?:\.env|README\.md) - [F,L]
RewriteRule ^favicon\.ico$ favicon.svg [L]
RewriteRule ^resume-consultation/[a-f0-9]{48}/?$ resume_consultation.php [QSA,L]
RewriteRule ^account-settings/?$ account_settings.php [QSA,L]
RewriteRule ^my-business-cases/?$ my_business_cases.php [QSA,L]
RewriteRule ^build-business-case/?$ business_case_start.php [QSA,L]
RewriteRule ^business-case/?$ business_case_builder.php [QSA,L]
RewriteRule ^trust/?$ trust.php [QSA,L]
RewriteRule ^methodology/?$ methodology.php [QSA,L]
RewriteRule ^plans/?$ plans.php [QSA,L]
RewriteRule ^about-techselectai/?$ about_techselectai.php [QSA,L]
RewriteRule ^authority-analytics/?$ authority_analytics.php [QSA,L]
RewriteRule ^authority-submission-kit/?$ authority_submission_kit.php [QSA,L]
RewriteRule ^evidence-refresh/?$ evidence_refresh_review.php [QSA,L]
RewriteRule ^customer-outcomes-admin/?$ customer_outcomes_admin.php [QSA,L]
RewriteRule ^authority-admin/?$ authority_admin.php [QSA,L]
RewriteRule ^case-studies/?$ case_studies.php [QSA,L]
RewriteRule ^case-studies/[a-z0-9-]+/?$ case_study.php [QSA,L]

RewriteRule ^(login|register|verify-email|reset-password)/?$ brand_page.php [QSA,L]
RewriteRule ^admin/?$ brand_page.php [QSA,L]
RewriteRule ^review/[a-z0-9-]+/?$ brand_page.php [QSA,L]
RewriteRule ^my-reviews/?$ brand_page.php [QSA,L]
RewriteRule ^my-consultations/?$ brand_page.php [QSA,L]
RewriteRule ^buyer-analytics/?$ brand_page.php [QSA,L]
RewriteRule ^review-moderation/?$ brand_page.php [QSA,L]
RewriteRule ^review-rewards/?$ brand_page.php [QSA,L]
RewriteRule ^taxonomy-queue/?$ brand_page.php [QSA,L]
RewriteRule ^pri-source-policy/?$ brand_page.php [QSA,L]
RewriteRule ^ai-referrals/?$ brand_page.php [QSA,L]
RewriteRule ^(?:account|admin|review|my_reviews|my_consultations|buyer_analytics|review_moderation|review_rewards|taxonomy_queue|pri_source_policy|ai_referrals)\.php$ brand_page.php [QSA,L]

RewriteRule ^software/[a-z0-9-]+/?$ customer_outcome_links_page.php [QSA,L]
RewriteRule ^categories/[a-z0-9-]+/?$ customer_outcome_links_page.php [QSA,L]
RewriteRule ^capabilities/[a-z0-9-]+/?$ brand_page.php [QSA,L]
RewriteRule ^integrations/[a-z0-9-]+/?$ brand_page.php [QSA,L]
RewriteRule ^compare/[a-z0-9-]+-vs-[a-z0-9-]+/?$ customer_outcome_links_page.php [QSA,L]
RewriteRule ^guides/(?:hrms-arabic-mena|itsm-multi-site-enterprise)/?$ scenario_decision_guide.php [QSA,L]
RewriteRule ^guides/[a-z0-9-]+/?$ decision_guide.php [QSA,L]
RewriteRule ^sitemap\.xml$ sitemap.php [QSA,L]

RewriteRule ^api/auth/.*$ api/auth.php [QSA,L]
RewriteRule ^api/account(?:/.*)?$ api/account_history.php [QSA,L]
RewriteRule ^api/business-cases(?:/.*)?$ api/business_cases.php [QSA,L]
RewriteRule ^api/evidence-refresh(?:/.*)?$ api/evidence_refresh_review.php [QSA,L]
RewriteRule ^api/customer-outcomes(?:/.*)?$ api/customer_outcomes.php [QSA,L]
RewriteRule ^api/authority-sources(?:/.*)?$ api/authority_sources.php [QSA,L]
RewriteRule ^api/buyer-analytics/?$ api/buyer_analytics.php [QSA,L]
RewriteRule ^api/admin/.*$ api/admin.php [QSA,L]
RewriteRule ^api/review-admin(?:/.*)?$ api/review_admin.php [QSA,L]
RewriteRule ^api/review-rewards(?:/.*)?$ api/review_rewards.php [QSA,L]
RewriteRule ^api/reviews(?:/.*)?$ api/reviews.php [QSA,L]
RewriteRule ^api/taxonomy/.*$ api/taxonomy.php [QSA,L]
RewriteRule ^api/consultations/[a-f0-9]{48}/promotion(?:/(?:impression|click))?/?$ api/promotion.php [QSA,L]
RewriteRule ^api/consultations/[a-f0-9]+/recommendations/?$ api/recommend.php [QSA,L]
RewriteRule ^api/consultations(?:/.*)?$ api/secure.php [QSA,L]

RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

RewriteRule ^(api/.*|health|robots\.txt)$ api/index.php [QSA,L]
RewriteRule ^ index.html [L]
