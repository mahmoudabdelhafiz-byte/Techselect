RewriteEngine On

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "DENY"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
</IfModule>

# Block direct web access to internal/source material when repository folders are uploaded.
RewriteRule ^(?:app|db|docs|scripts)/ - [F,L]
RewriteRule ^(?:\.env|README\.md) - [F,L]

# Human-facing account/admin routes.
RewriteRule ^(login|register|verify-email|reset-password)/?$ account.php [QSA,L]
RewriteRule ^admin/?$ admin.php [QSA,L]

# Server-rendered public SEO documentation.
RewriteRule ^software/[a-z0-9-]+/?$ public_docs.php [QSA,L]
RewriteRule ^categories/[a-z0-9-]+/?$ public_docs.php [QSA,L]
RewriteRule ^capabilities/[a-z0-9-]+/?$ public_docs.php [QSA,L]
RewriteRule ^integrations/[a-z0-9-]+/?$ public_docs.php [QSA,L]
RewriteRule ^compare/[a-z0-9-]+-vs-[a-z0-9-]+/?$ public_docs.php [QSA,L]
RewriteRule ^sitemap\.xml$ sitemap.php [QSA,L]

# Dedicated release APIs: order matters.
RewriteRule ^api/auth/.*$ api/auth.php [QSA,L]
RewriteRule ^api/admin/.*$ api/admin.php [QSA,L]
RewriteRule ^api/consultations/[a-f0-9]+/recommendations/?$ api/recommend.php [QSA,L]
RewriteRule ^api/consultations(?:/.*)?$ api/secure.php [QSA,L]

# Serve existing public files/directories directly.
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# Read-only API and SEO endpoints.
RewriteRule ^(api/.*|health|robots\.txt)$ api/index.php [QSA,L]

# React/Vite SPA fallback.
RewriteRule ^ index.html [L]
