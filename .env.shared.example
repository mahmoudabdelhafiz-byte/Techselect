DB_HOST=localhost
DB_NAME=techselect
DB_USER=techselect
DB_PASS=
SITE_URL=https://techselectai.com
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5
MAIL_FROM=no-reply@techselectai.com

# Optional external sign-in. Never commit real client secrets.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
MICROSOFT_OAUTH_CLIENT_ID=
MICROSOFT_OAUTH_CLIENT_SECRET=
# Use "common" for work/school + personal Microsoft accounts, or a tenant ID/domain to restrict sign-in.
MICROSOFT_OAUTH_TENANT=common

# Optional Google Play Developer API reviews connector.
# Point to a service-account JSON file stored outside the public web root. Never commit the credential file.
# The service account must be granted appropriate Play Console access to the mapped application.
TECHSELECT_GOOGLE_PLAY_SERVICE_ACCOUNT_FILE=
